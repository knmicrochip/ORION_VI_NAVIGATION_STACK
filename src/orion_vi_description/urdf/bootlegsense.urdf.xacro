<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
<xacro:macro name="add_realsense_link" params="suffix">
    <link name="realsense_${suffix}_link">
      <inertial>
        <mass>0.0615752</mass>
        <inertia>
          <ixx>9.108e-05</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>2.51e-06</iyy>
          <iyz>0</iyz>
          <izz>8.931e-05</izz>
        </inertia>
        <pose frame=''>0 0 0 0 -0 0</pose>
      </inertial>
      <collision name="collision">
        <geometry>
          <mesh filename="meshes/realsense.dae"/>
        </geometry>
      </collision>
      <visual name= "visual">
        <geometry>
          <mesh filename="meshes/realsense.dae">
          <submesh>
              <name>RealSense</name>
              <center>false</center>
          </submesh>
          </mesh>
        </geometry>
        <material>
          <diffuse>1.0 1.0 1.0</diffuse>
          <specular>1.0 1.0 1.0</specular>
          <pbr>
            <metal>
              <albedo_map>sensors/RealSense_D435/materials/textures/RealSense_Albedo.png</albedo_map>
              <normal_map>sensors/RealSense_D435/materials/textures/RealSense_Normal.png</normal_map>
              <metalness_map>sensors/RealSense_D435/materials/textures/RealSense_Metalness.png</metalness_map>
              <roughness_map>sensors/RealSense_D435/materials/textures/RealSense_Roughness.png</roughness_map>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
</xacro:macro>
</robot>
